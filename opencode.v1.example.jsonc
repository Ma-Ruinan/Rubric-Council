{
  "$schema": "https://opencode.ai/config.json",
  "model": "aiaaa/deepseek-v4.1-flash",
  "default_agent": "rubric-orchestrator",
  "provider": {
    "aiaaa": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI AAA",
      "options": {
        "baseURL": "https://aiaaa.cc/v1",
        "apiKey": "{env:AIAAA_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "variants": {
            "high": {
              "thinking": {
                "type": "enabled"
              },
              "reasoning_effort": "high"
            }
          }
        }
      }
    }
  }
}
